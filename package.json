{
  "name": "delta-updates",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Delta Update — Premium news publication built with React, Vite + TypeScript + Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:clean": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:all": "tsc -b",
    "lint": "echo 'lint: use editor TS diagnostics' && exit 0",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "audit:deps": "npm outdated || true",
    "deploy:vercel": "npm run build && vercel --prod",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist"
  },
  "engines": {
    "node": ">=20.x",
    "npm": ">=10.x"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^2.1.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.1"
  }
}
